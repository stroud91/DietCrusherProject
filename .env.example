# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
# Local development uses SQLite. On Render this is your Postgres "Internal Database URL".
DATABASE_URL=sqlite:///dev.db
# Postgres schema used in production (snake_case)
SCHEMA=diet_crusher_schema
# Set to "production" on Render only
# FLASK_ENV=production
